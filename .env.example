# ===================================================================
# TradeX Environment Configuration Example
# Copy this file to '.env' for local Docker Compose or deployment
# DO NOT COMMIT YOUR ACTUAL '.env' FILE CONTAINING SECRETS TO GIT
# ===================================================================

# Active Spring Profile (options: 'dev' for local PostgreSQL, 'supabase' for Supabase Cloud DB)
SPRING_PROFILES_ACTIVE=dev

# Local PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tradex
DB_HOST=postgres
DB_PORT=5432

# Hosted Supabase Database Configuration (Required when SPRING_PROFILES_ACTIVE=supabase)
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.YOUR_SUPABASE_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Security Secrets
JWT_SECRET=YOUR_MINIMUM_256_BIT_SECRET_KEY_HERE_FOR_JWT_TOKEN_SIGNING
JWT_EXPIRATION=86400000

# Server Ports
PORT=8080
FRONTEND_PORT=3000
